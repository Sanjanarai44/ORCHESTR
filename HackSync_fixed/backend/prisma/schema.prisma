generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id           String        @id @default(cuid())
  name         String
  eventType    String        @default("hackathon")
  status       String        @default("active")
  config       String        // JSON string of full event config
  organizerId  String
  createdAt    DateTime      @default(now())
  participants Participant[]
  teams        Team[]
  judges       Judge[]
}

model Participant {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  college   String
  skill     String
  stage     String   @default("roster")
  sessionNotes String? // Added for per-participant session notes
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  mentorConversations MentorConversation[]

  @@unique([eventId, email])
}

model Team {
  id                String              @id @default(cuid())
  eventId           String
  name              String
  status            String              @default("DRAFT")
  aiRationale       String?
  problemStatement  String?
  evaluationGuide   String?
  resultsHeld       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  event             Event               @relation(fields: [eventId], references: [id])
  members           TeamMember[]
  evaluations       Evaluation[]
  anomalyFlags      AnomalyFlag[]
  mentorMessages    MentorConversation[]
}

model TeamMember {
  id      String  @id @default(cuid())
  teamId  String
  name    String
  email   String?
  skill   String?
  college String?
  team    Team    @relation(fields: [teamId], references: [id])
}

model Judge {
  id             String       @id @default(cuid())
  eventId        String
  email          String
  name           String
  jwtToken       String?
  tokenUsed      Boolean      @default(false)
  assignedTeams  String       @default("[]")
  createdAt      DateTime     @default(now())
  event          Event        @relation(fields: [eventId], references: [id])
  evaluations    Evaluation[]
  anomalyFlags   AnomalyFlag[]

  @@unique([eventId, email])
}

model Evaluation {
  id                String    @id @default(cuid())
  judgeId           String
  teamId            String
  scoreCode         Int
  scoreInnovation   Int
  scorePresentaion  Int
  starRating        Int       @default(0)
  comment           String
  discarded         Boolean   @default(false)
  overrideScore     Float?
  submittedAt       DateTime  @default(now())
  judge             Judge     @relation(fields: [judgeId], references: [id])
  team              Team      @relation(fields: [teamId], references: [id])

  @@unique([judgeId, teamId])
}

model AnomalyFlag {
  id             String   @id @default(cuid())
  teamId         String
  judgeId        String
  newScore       Float
  panelAvg       Float
  deviation      Float
  llmExplanation String?
  status         String   @default("PENDING")
  resolution     String?
  createdAt      DateTime @default(now())
  team           Team     @relation(fields: [teamId], references: [id])
  judge          Judge    @relation(fields: [judgeId], references: [id])
}

model EmailLog {
  id             String    @id @default(cuid())
  recipientId    String
  recipientEmail String?
  recipientName  String?
  emailType      String
  status         String    @default("PENDING")
  sentAt         DateTime?
  errorMessage   String?
  attempts       Int       @default(0)
  jobId          String?
  createdAt      DateTime  @default(now())
}

model MentorConversation {
  id            String       @id @default(cuid())
  teamId        String
  participantId String?
  role          String
  content       String
  timestamp     DateTime     @default(now())
  team          Team         @relation(fields: [teamId], references: [id])
  participant   Participant? @relation(fields: [participantId], references: [id])
}

model EventSettings {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model AiEmailContent {
  id          String   @id @default(cuid())
  recipientId String
  emailType   String
  subject     String
  htmlBody    String
  createdAt   DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
